bash
# Discover NVMe/TCP targets (default port 4420)
nvme discover -t tcp -a <ONTAP_LIF_IP> -s 4420

# Connect to target
nvme connect -t tcp -a <ONTAP_LIF_IP> -s 4420 \
  -n <subsystem_nqn>

# List connected devices
